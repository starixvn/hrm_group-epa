<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>SMS.EPA.Criteria</RootNamespace>
    <AssemblyName>SMS.EPA.Criteria</AssemblyName>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Fanex.Data" Version="4.3.4.5" />
    <PackageReference Include="Fanex.Data.Repository" Version="4.3.4.5" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="9.12.0.78982">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SMS.EPA.Core\SMS.EPA.Core.csproj" />
    <ProjectReference Include="..\SMS.EPA.Models\SMS.EPA.Models.csproj" />
  </ItemGroup>

</Project>