<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>SMS.EPA.ServicesAPI</RootNamespace>
    <AssemblyName>SMS.EPA.ServicesAPI</AssemblyName>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Fanex.Data" Version="4.3.4.5" />
    <PackageReference Include="Fanex.Data.Repository" Version="4.3.4.5" />
    <PackageReference Include="Fanex.Data.SqlServer" Version="4.3.4.5" />
    <PackageReference Include="jose-jwt" Version="5.2.0" />
    <PackageReference Include="log4net" Version="2.0.15" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Core" Version="5.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="9.0.0" />
    <PackageReference Include="Microsoft.CodeDom.Providers.DotNetCompilerPlatform" Version="4.1.0" />
    <PackageReference Include="Microsoft.Owin" Version="4.2.2" />
    <PackageReference Include="Microsoft.Owin.Cors" Version="4.2.2" />
    <PackageReference Include="Microsoft.Owin.Host.SystemWeb" Version="4.2.2" />
    <PackageReference Include="Microsoft.Owin.Security" Version="4.2.2" />
    <PackageReference Include="Microsoft.Owin.Security.Cookies" Version="3.0.1" />
    <PackageReference Include="Microsoft.Owin.Security.OAuth" Version="4.2.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Newtonsoft.Json.Bson" Version="1.0.2" />
    <PackageReference Include="Owin" Version="1.0" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="9.12.0.78982">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SMS.EPA.Core\SMS.EPA.Core.csproj" />
    <ProjectReference Include="..\SMS.EPA.Models\SMS.EPA.Models.csproj" />
    <ProjectReference Include="..\SMS.EPA.Resources\SMS.EPA.Resources.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="App_Data\SpName.xml" />
    <Content Include="logs\log.txt" />
    <Content Include="Web.config" />
    <Content Include="Web.Debug.config">
      <DependentUpon>Web.config</DependentUpon>
    </Content>
    <Content Include="Web.Release.config">
      <DependentUpon>Web.config</DependentUpon>
    </Content>
    <Content Include="WebConfigs\Web.pro.cti.config" />
    <Content Include="WebConfigs\Web.pro.hm.config" />
    <Content Include="WebConfigs\Web.pro.lexfin.config" />
    <Content Include="WebConfigs\Web.pro.sms.config" />
  </ItemGroup>

</Project>