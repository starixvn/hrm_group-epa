@model SMS.EPA.Models.Authentication.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>
        Welcome to SMS EPA
    </title>
    <link rel="stylesheet" href="~/Content/css/login.min.css" />
</head>
<body>
    <div id="panel" class="container login">
        <div class="header-login row">
            <div class="header-contain">
                <div>
                    <img src="~/Content/Site/images/epa_logo.png" alt=""/>
                </div>
                <div>
                    <img src="~/Content/Site/auth/images/lock-icon.png" alt=""/>
                </div>
            </div>
        </div>
        <div id="formContainer" class="row auth">
            @using (Html.BeginForm())
            {
                @Html.Hidden("returnPath", Context.Request.Query["ReturnPath"])
                @Html.TextBoxFor(model => model.Username, new { placeholder = "Username", @class = "col-sm-12 username" })
                @Html.PasswordFor(model => model.Password, new { placeholder = "Password", @class = "col-sm-12 password" })
                <input type="submit" name="submit" class="col-sm-12 btn-submit" value="Log In" />
            }
            <div class="message-error">
                @if (Model != null && !ViewData.ModelState.IsValid)
                {
                    var errMsg = ViewData.ModelState.Values.SelectMany(x => x.Errors).Select(x => x.ErrorMessage).LastOrDefault();
                    <i class="icon-error"></i>@errMsg
                }
            </div>
        </div>
    </div>
</body>
</html>